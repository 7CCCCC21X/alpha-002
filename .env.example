# BSC RPC，建议用自己的稳定 RPC；公共 RPC 容易限速
RPC_URL=https://bsc-dataseed.binance.org/

# Telegram BotFather 给你的 token
TG_BOT_TOKEN=填你的TG机器人TOKEN

# 群 / 频道 / 私聊 chat_id；支持逗号分隔多个，告警会推给每一个
TG_CHAT_ID=填你的CHAT_ID

# 控制命令白名单（TG 用户 ID，逗号分隔）。只有这些人能用 /status /test /preview
# 留空 = 没有人能控制；任何人都能用 /id 查到自己的 ID 再加进来
WHITELIST_IDS=

# 监听的合约，也就是交易里的 To
TARGET_CONTRACT=0xb0bb171D333569CfD28a37F5c5DdDAAa90aD46af

# 默认只监听这个地址发起的 initializePool
# 想监听所有人调用这个合约的 initializePool，就把这里留空：FILTER_FROM=
FILTER_FROM=0xb55eDCBEc988931a1f25f541B1C09F7AB817CD9E

# 第一次启动从哪个区块开始扫。
# 不填则从当前最新块开始，不会推历史交易。
# 示例交易区块是 99031467，要测试历史推送可填：
# START_BLOCK=99031467
START_BLOCK=

# 每隔多少毫秒检查一次新区块（默认 30 秒）
# 开始时间显示时区（Asia/Shanghai=北京、Asia/Taipei=台北）
POLL_MS=30000
MAX_BLOCKS_PER_TICK=40
TIMEZONE=Asia/Shanghai

# 扫块确认数，避免链重组：只扫已过 N 个确认的块（BSC 主网建议 3-5）
CONFIRMATIONS=3

# 单次 RPC 调用超时（毫秒）
RPC_TIMEOUT_MS=15000

# 是否显示 Hooks / PoolManager / Parameters / sqrtPriceX96 等底层调试字段
SHOW_DEBUG_FIELDS=false

# 消息结尾的社群引流（COMMUNITY_URL 留空则不显示页脚）
COMMUNITY_NAME=小C聊天群
COMMUNITY_URL=https://t.me/xiaoc236

# 游标 / 池子缓存文件路径。Railway 文件系统是临时的，重启会丢失。
# 如需持久化，挂载 Railway Volume 后把这两个指向挂载点，例如 /data/lastBlock.txt、/data/pools.json
CURSOR_FILE=./lastBlock.txt
POOLS_FILE=./pools.json
