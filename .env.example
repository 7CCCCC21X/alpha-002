# BSC RPC。DATA_SOURCE=rpc 时这是主要数据源，用免费公共 RPC 即零成本、无需 Key。
# 可不填（默认 publicnode）；也可逗号分隔多个，按顺序使用。末尾总会自动加 publicnode 兜底：
# 当前 RPC 连续 3 轮读不到最新区块（Key 被停用 / 额度用完 / 宕机）就自动换下一个，机器人不会退出。
# 2026-11 实测（免 Key 公共端点）：
#   ✅ https://bsc-rpc.publicnode.com  推荐：完整区块 / eth_getLogs / 近 1 万块的历史 nonce 全都正常
#   ⚠️ https://bsc-dataseed.binance.org  官方节点，区块和 nonce 正常，但完全不支持 eth_getLogs，
#      经 CLPositionManager 建的池子收不到（机器人会自动跳过事件扫描，不会卡住）
#   ⚠️ https://bsc-mainnet.public.blastapi.io  区块正常，eth_getLogs 被限流
#   ⚠️ https://rpc-bsc.48.club  区块正常，但链头落后几十块、不能按区块查 nonce
#   ❌ bsc.drpc.org / 1rpc.io / bsc.meowrpc.com 公共端点实测被限流；rpc.ankr.com、BlockPI 现在要注册（免费）Key；
#      binance.llamarpc.com、omniatech 连不上
RPC_URL=https://bsc-rpc.publicnode.com

# Telegram BotFather 给你的 token
TG_BOT_TOKEN=填你的TG机器人TOKEN

# 固定收件会话 chat_id；支持逗号分隔多个，告警始终推给它们。
# 可留空，改用动态订阅：白名单用户在群里发 /subscribe 即可让该群收告警。
TG_CHAT_ID=填你的CHAT_ID

# 控制命令白名单（TG 用户 ID，逗号分隔）。只有这些人能用 /status /test /preview
# 留空 = 没有人能控制；任何人都能用 /id 查到自己的 ID 再加进来
WHITELIST_IDS=

# 主过滤：盯这个操作钱包发起的调用（initializePool / addPoolOwners / setPoolStartedTimestamp）。
# 钱包比合约稳定，项目方换合约也不会漏。留空 = 不按 From 过滤（需配合 TARGET_CONTRACT）。
FILTER_FROM=0xb55eDCBEc988931a1f25f541B1C09F7AB817CD9E

# 限定合约（交易里的 To），逗号分隔多个。留空 = 不限合约，只靠 FILTER_FROM 盯钱包。
# 想精确只盯某几个 Hook 合约时再填，例如：
# TARGET_CONTRACT=0xb0BAa371b899950B4Ef6A27c21bAf5ef7c434d0f,0xb0bb171D333569CfD28a37F5c5DdDAAa90aD46af
TARGET_CONTRACT=

# 注意：FILTER_FROM 和 TARGET_CONTRACT 不能同时留空，否则会匹配全网调用、严重误报。

# 第一次启动从哪个区块开始扫。
# 不填则从当前最新块开始，不会推历史交易。
# 示例交易区块是 99031467，要测试历史推送可填：
# START_BLOCK=99031467
START_BLOCK=

# 轮询间隔：每隔 POLL_MS 毫秒查一次数据源。
POLL_MS=10000

# 仅 DATA_SOURCE=rpc 且设了 FILTER_FROM：nonce 省流（默认开）。每轮先查操作钱包的 nonce，
# 没变 = 钱包没发交易 = 不可能命中，整段跳过、一个区块都不拉；变了才二分定位到具体区块。
# 空闲时每轮只有 3 次轻量调用。RPC 查不了历史 nonce 时自动退回逐块扫描。设 0 = 每块都拉。
NONCE_GATE=1

# 数据源：怎么发现目标地址的交易。
#   DATA_SOURCE=rpc       → 直接查 RPC（配合 nonce 省流）。无需 Key、配免费公共 RPC 零成本、无月度额度可耗尽（推荐）。
#   DATA_SOURCE=nodereal  → NodeReal 免费索引 API。免费月额度较小，24/7 每 10 秒轮询会超额（需调大 POLL_MS 或付费）。
#   DATA_SOURCE=ankr      → Ankr Advanced API。省 RPC，但该 Key 需开通 Advanced API 权限，否则 -32052/403。
#   DATA_SOURCE=etherscan → Etherscan V2 txlist（注意：免费版已不支持 BSC，需付费计划）。
# nodereal / ankr / etherscan 连续 3 轮拉取失败（Key 停用、额度用完等）会自动改用 rpc，告警不中断。
DATA_SOURCE=rpc

# —— NodeReal MegaNode（DATA_SOURCE=nodereal 时用；推荐）——
# 去 https://nodereal.io 免费注册，创建 BSC 项目拿 API Key，填到 NODEREAL_API_KEY。
# 原理：用 nr_getTransactionByAddress 列出操作钱包的交易，命中的再用 RPC 查回执，几乎不花钱。
NODEREAL_API=https://bsc-mainnet.nodereal.io/v1
NODEREAL_API_KEY=

# 仅 DATA_SOURCE=rpc 时用：单轮最多处理多少块（须高于出块速度以清积压；BSC 0.45 秒一块，约 22 块/10 秒）。
RPC_MAX_BLOCKS_PER_TICK=200

# —— Ankr Advanced API（DATA_SOURCE=ankr 时用）——
# 用你 Ankr 账号的 API Key（就是 Ankr RPC 端点 https://rpc.ankr.com/bsc/<KEY> 里的那段 KEY）。
# ANKR_API_KEY 留空时，会自动从上面的 RPC_URL 里提取。去 https://www.ankr.com/rpc/ 免费注册获取。
ANKR_ADVANCED_API=https://rpc.ankr.com/multichain
ANKR_API_KEY=
ANKR_BLOCKCHAIN=bsc

# —— Etherscan V2 / BscScan（仅 DATA_SOURCE=etherscan 时用；免费版不含 BSC）——
EXPLORER_API=https://api.etherscan.io/v2/api
EXPLORER_API_KEY=
EXPLORER_CHAIN_ID=56
# 开始时间显示时区（Asia/Shanghai=北京、Asia/Taipei=台北）
TIMEZONE=Asia/Shanghai

# 扫块确认数，避免链重组：只扫已过 N 个确认的块（BSC 主网建议 3-5）
CONFIRMATIONS=3

# 单次 RPC 调用超时（毫秒）
RPC_TIMEOUT_MS=15000

# 消息结尾的社群引流（COMMUNITY_URL 留空则不显示页脚）
COMMUNITY_NAME=小C聊天群
COMMUNITY_URL=https://t.me/xiaoc236

# 游标 / 池子缓存 / 订阅会话 文件路径。Railway 文件系统是临时的，重启会丢失。
# 如需持久化，挂载 Railway Volume 后把这几个指向挂载点，例如 /data/lastBlock.txt 等。
CURSOR_FILE=./lastBlock.txt
POOLS_FILE=./pools.json
SUBSCRIBERS_FILE=./subscribers.json
