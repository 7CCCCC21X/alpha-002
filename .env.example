# BSC RPC。DATA_SOURCE=rpc 时这是主要数据源，用免费公共 RPC 即零成本（可能偶尔限速）。
# 免费公共可选：https://bsc-rpc.publicnode.com 、https://bsc-dataseed.binance.org 、https://binance.llamarpc.com
# 若用 Ankr/付费计量端点跑 DATA_SOURCE=rpc（逐块）会较贵，建议改用免费公共 RPC。
RPC_URL=https://bsc-rpc.publicnode.com

# Telegram BotFather 给你的 token
TG_BOT_TOKEN=填你的TG机器人TOKEN

# 固定收件会话 chat_id；支持逗号分隔多个，告警始终推给它们。
# 可留空，改用动态订阅：白名单用户在群里发 /subscribe 即可让该群收告警。
TG_CHAT_ID=填你的CHAT_ID

# 控制命令白名单（TG 用户 ID，逗号分隔）。只有这些人能用 /status /test /preview
# 留空 = 没有人能控制；任何人都能用 /id 查到自己的 ID 再加进来
WHITELIST_IDS=

# 主过滤：盯这个操作钱包发起的调用（initializePool / addPoolOwners / setPoolStartedTimestamp）。
# 钱包比合约稳定，项目方换合约也不会漏。留空 = 不按 From 过滤（需配合 TARGET_CONTRACT）。
FILTER_FROM=0xb55eDCBEc988931a1f25f541B1C09F7AB817CD9E

# 限定合约（交易里的 To），逗号分隔多个。留空 = 不限合约，只靠 FILTER_FROM 盯钱包。
# 想精确只盯某几个 Hook 合约时再填，例如：
# TARGET_CONTRACT=0xb0BAa371b899950B4Ef6A27c21bAf5ef7c434d0f,0xb0bb171D333569CfD28a37F5c5DdDAAa90aD46af
TARGET_CONTRACT=

# 注意：FILTER_FROM 和 TARGET_CONTRACT 不能同时留空，否则会匹配全网调用、严重误报。

# 第一次启动从哪个区块开始扫。
# 不填则从当前最新块开始，不会推历史交易。
# 示例交易区块是 99031467，要测试历史推送可填：
# START_BLOCK=99031467
START_BLOCK=

# 轮询间隔：每隔 POLL_MS 毫秒查一次数据源的目标地址交易（不再逐块拉 RPC，省钱）。
POLL_MS=10000

# 数据源：怎么发现目标地址的交易。
#   DATA_SOURCE=rpc       → 逐块拉 eth_getBlockByNumber。最省心、无需任何 API Key；
#                           配合免费/自建 RPC（见下方 RPC_URL）即零成本。付费计量 RPC 上会较贵。
#   DATA_SOURCE=ankr      → Ankr Advanced API（ankr_getTransactionsByAddress）。省 RPC，
#                           但该 Key 需开通 Advanced API 权限，否则报 -32052/403。
#   DATA_SOURCE=etherscan → Etherscan V2 txlist（注意：免费版已不支持 BSC，需付费计划）。
DATA_SOURCE=rpc

# 仅 DATA_SOURCE=rpc 时用：逐块模式单轮最多扫多少块（须高于出块速度以清积压）。
RPC_MAX_BLOCKS_PER_TICK=200

# —— Ankr Advanced API（DATA_SOURCE=ankr 时用）——
# 用你 Ankr 账号的 API Key（就是 Ankr RPC 端点 https://rpc.ankr.com/bsc/<KEY> 里的那段 KEY）。
# ANKR_API_KEY 留空时，会自动从上面的 RPC_URL 里提取。去 https://www.ankr.com/rpc/ 免费注册获取。
ANKR_ADVANCED_API=https://rpc.ankr.com/multichain
ANKR_API_KEY=
ANKR_BLOCKCHAIN=bsc

# —— Etherscan V2 / BscScan（仅 DATA_SOURCE=etherscan 时用；免费版不含 BSC）——
EXPLORER_API=https://api.etherscan.io/v2/api
EXPLORER_API_KEY=
EXPLORER_CHAIN_ID=56
# 开始时间显示时区（Asia/Shanghai=北京、Asia/Taipei=台北）
TIMEZONE=Asia/Shanghai

# 扫块确认数，避免链重组：只扫已过 N 个确认的块（BSC 主网建议 3-5）
CONFIRMATIONS=3

# 单次 RPC 调用超时（毫秒）
RPC_TIMEOUT_MS=15000

# 消息结尾的社群引流（COMMUNITY_URL 留空则不显示页脚）
COMMUNITY_NAME=小C聊天群
COMMUNITY_URL=https://t.me/xiaoc236

# 游标 / 池子缓存 / 订阅会话 文件路径。Railway 文件系统是临时的，重启会丢失。
# 如需持久化，挂载 Railway Volume 后把这几个指向挂载点，例如 /data/lastBlock.txt 等。
CURSOR_FILE=./lastBlock.txt
POOLS_FILE=./pools.json
SUBSCRIBERS_FILE=./subscribers.json
